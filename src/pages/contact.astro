---
import BaseLayout from "../layouts/BaseLayout.astro"
---
<BaseLayout title="Nick Morrow :|: Contact">
  <div class="bg-dark container contact-page">
    <div class="contact-grid">
      <div class="contact-intro">
        <h1>Get in Touch</h1>
        <p>
          I'm always open to discussing new projects, creative ideas, or opportunities to be part of your vision.
          If you have a question or proposal, please don't hesitate to reach out using the form.
        </p>
        <p>Alternatively, you can connect with me on professional networks.</p>
        <!-- You can add social/professional links here later -->
      </div>

      <form
        class="cntctForm"
        method="POST"
        action="https://script.google.com/macros/s/AKfycbwrMmZitFXV7NsCpvcj-30LVH9_Knhq08G6pyjzFKSIRmg8uhNoF0Iem6zjSriZo405/exec"
      >
        <div class="form-elements">
          <fieldset>
            <label for="name">Name: </label>
            <input id="name" name="name" placeholder="Your preferred professional name" required />
          </fieldset>

          <fieldset>
            <label for="email">Email Address:</label>
            <input id="email" name="email" type="email" value="" placeholder="yourEmail@email.com" required />
            <span class="email-invalid">Must be a valid email address</span>
          </fieldset>

          <fieldset>
            <label for="message">Message: </label>
            <textarea id="message" name="message" rows="8" placeholder="What are you contacting me about..." required></textarea>
          </fieldset>

          <!-- Submit -->
          <button>Send Message</button>
        </div>

        <!-- Thank You! -->
        <div class="thankyou_message">
          <h2>
            <em>Thank you</em> for contacting me!<br />I will get back to you soon!
          </h2>
        </div>
      </form>
    </div>
  </div>

  <script is:inline data-async="false" type="text/javascript" src="/assets/js/form-submission-handler.js"></script>
</BaseLayout>